# Postgres connection string. Use "npx prisma dev" for a quick local instance,
# or point to a real Postgres (Neon, Supabase, Vercel Postgres, etc).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpgmasterhub?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-real-secret"

# "local" (default in dev) writes uploads to public/uploads.
# "vercel-blob" (required in production) uses @vercel/blob — set BLOB_READ_WRITE_TOKEN too.
STORAGE_PROVIDER="local"
# BLOB_READ_WRITE_TOKEN=
