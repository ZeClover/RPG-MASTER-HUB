# Postgres connection string. Use "npx prisma dev" for a quick local instance,
# or point to a real Postgres (Neon, Supabase, Vercel Postgres, etc).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpgmasterhub?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-real-secret"

# "local" (default in dev) writes uploads to public/uploads.
# "vercel-blob" (required in production) uses @vercel/blob — set BLOB_READ_WRITE_TOKEN too.
STORAGE_PROVIDER="local"
# BLOB_READ_WRITE_TOKEN=

# Fase 4 — Bots do Discord. Cada bot é uma Application separada no Discord
# Developer Portal (https://discord.com/developers/applications), com seu
# próprio token — ver ARCHITECTURE.md ("Bots do Discord") para o desenho.
# Ambos os pares são opcionais: sem eles, os endpoints de bot ficam inativos
# e o resto do hub funciona normalmente.
# DISCORD_SFX_BOT_TOKEN=
# DISCORD_SFX_BOT_CLIENT_ID=
# DISCORD_MUSIC_BOT_TOKEN=
# DISCORD_MUSIC_BOT_CLIENT_ID=

# Secret compartilhado entre o hub e os processos de bot — autentica as
# chamadas dos bots à API do hub. Generate com: openssl rand -base64 32
BOT_SERVICE_SECRET="replace-me-with-a-real-secret"

# Fase 12 — Backup automático diário (ver ARCHITECTURE.md e vercel.json).
# A Vercel injeta "Authorization: Bearer $CRON_SECRET" automaticamente nas
# chamadas do Cron Job quando esta variável está configurada no projeto.
# Sem ela, a rota /api/cron/backup-campaigns recusa rodar (fail closed) —
# o resto do hub funciona normalmente, só o backup automático fica inativo
# (o backup manual em Configurações → Dados não depende disto). Generate com:
# openssl rand -base64 32
CRON_SECRET="replace-me-with-a-real-secret"
