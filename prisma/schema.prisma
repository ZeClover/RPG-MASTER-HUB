// RPG Master Hub
// Fase 0: usuários, autenticação (Auth.js) e campanhas.
// Fase 1: wiki da campanha — NPCs, Locais, Facções, Lore, Ideias, Tags e
// o sistema genérico de Relacionamentos (ver ARCHITECTURE.md, seção "Relacionamentos").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  OWNER
  CO_GM
  PLAYER
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  campaigns   Campaign[]       @relation("CampaignOwner")
  memberships CampaignMember[]

  @@map("users")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  bannerUrl      String?
  iconUrl        String?
  symbolUrl      String?
  backgroundUrl  String?
  primaryColor   String?
  secondaryColor String?
  status         CampaignStatus @default(ACTIVE)
  archivedAt     DateTime?
  lastSessionAt  DateTime?
  nextSessionAt  DateTime?

  ownerId String
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members CampaignMember[]

  npcs          Npc[]
  locations     Location[]
  factions      Faction[]
  lorePages     LorePage[]
  ideas         Idea[]
  tags          Tag[]
  relationships Relationship[]

  sessionPlans      SessionPlan[]
  scenes            Scene[]
  quests            Quest[]
  plotThreads       PlotThread[]
  consequences      Consequence[]
  sessionLogEntries SessionLogEntry[]
  combatEncounters  CombatEncounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 1 — Wiki da campanha
// ─────────────────────────────────────────────────────────────────────────

/// Ciclo de vida narrativo do conteúdo (independente do `archived` de cada
/// entidade, que é só um "esconder da minha lista de trabalho" organizacional).
enum CanonStatus {
  DRAFT
  PROPOSED
  APPROVED
  CANON
  OBSOLETE
  ARCHIVED
}

enum Visibility {
  GM_ONLY
  PLAYERS
  PUBLIC
}

enum IdeaState {
  NEW
  INTERESTING
  DEVELOPING
  USED
  ARCHIVED
  DISCARDED
}

/// Tipos de entidade que podem participar de um Relationship. Estender este
/// enum é o custo esperado para plugar um novo tipo de conteúdo no sistema de
/// relacionamentos (ver ARCHITECTURE.md).
enum RelatableEntityType {
  NPC
  LOCATION
  FACTION
  LORE_PAGE
  QUEST
  PLOT_THREAD
  CONSEQUENCE
}

enum RelationshipImportance {
  LOW
  MEDIUM
  HIGH
}

model Npc {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name            String
  imageUrl        String?
  age             String?
  species         String?
  gender          String?
  appearance      String?
  personality     String?
  history         String?
  goals           String?
  fears           String?
  secrets         String?
  narrativeStatus String?
  gmNotes         String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags NpcTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("npcs")
}

model Location {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name         String
  imageUrl     String?
  description  String?
  locationType String?
  notes        String?

  parentLocationId String?
  parent           Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children         Location[] @relation("LocationHierarchy")

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags LocationTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@index([parentLocationId])
  @@map("locations")
}

model Faction {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  imageUrl    String?
  factionType String?
  description String?
  history     String?
  goals       String?
  resources   String?
  secrets     String?
  notes       String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags FactionTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("factions")
}

model LorePage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title    String
  content  String?
  imageUrl String?
  category String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags LorePageTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("lore_pages")
}

model Idea {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title   String
  content String?
  state   IdeaState @default(NEW)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags IdeaTag[]

  @@index([campaignId, archived])
  @@index([campaignId, state])
  @@map("ideas")
}

model Tag {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name  String
  slug  String
  color String?

  createdAt DateTime @default(now())

  npcs         NpcTag[]
  locations    LocationTag[]
  factions     FactionTag[]
  lorePages    LorePageTag[]
  ideas        IdeaTag[]
  quests       QuestTag[]
  plotThreads  PlotThreadTag[]
  consequences ConsequenceTag[]

  @@unique([campaignId, slug])
  @@map("tags")
}

model NpcTag {
  npcId String
  npc   Npc    @relation(fields: [npcId], references: [id], onDelete: Cascade)
  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([npcId, tagId])
  @@index([tagId])
  @@map("npc_tags")
}

model LocationTag {
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([locationId, tagId])
  @@index([tagId])
  @@map("location_tags")
}

model FactionTag {
  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([factionId, tagId])
  @@index([tagId])
  @@map("faction_tags")
}

model LorePageTag {
  lorePageId String
  lorePage   LorePage @relation(fields: [lorePageId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lorePageId, tagId])
  @@index([tagId])
  @@map("lore_page_tags")
}

model IdeaTag {
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@index([tagId])
  @@map("idea_tags")
}

/// Relacionamento polimórfico genérico entre entidades da wiki. Ver
/// ARCHITECTURE.md ("Relacionamentos") para a discussão das alternativas e
/// por que este desenho foi escolhido.
model Relationship {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sourceType RelatableEntityType
  sourceId   String
  targetType RelatableEntityType
  targetId   String

  type        String
  description String?
  importance  RelationshipImportance?
  visibility  Visibility              @default(GM_ONLY)

  createdAt DateTime @default(now())

  @@index([campaignId, sourceType, sourceId])
  @@index([campaignId, targetType, targetId])
  @@map("relationships")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 2 — Preparação
// ─────────────────────────────────────────────────────────────────────────

enum SessionPlanStatus {
  PLANNING
  READY
  DONE
  CANCELLED
}

enum SceneStatus {
  PLANNED
  PLAYED
  CUT
}

enum QuestStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum PlotThreadStatus {
  ACTIVE
  DORMANT
  RESOLVED
  ABANDONED
}

enum ConsequenceStatus {
  PENDING
  TRIGGERED
  RESOLVED
}

model SessionPlan {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title         String
  sessionNumber Int?
  plannedDate   DateTime?
  pitch         String?
  gmNotes       String?
  status        SessionPlanStatus @default(PLANNING)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes           Scene[]
  checklist        ChecklistItem[]
  logEntries       SessionLogEntry[]
  combatEncounters CombatEncounter[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("session_plans")
}

model ChecklistItem {
  id            String      @id @default(cuid())
  sessionPlanId String
  sessionPlan   SessionPlan @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)

  label String
  done  Boolean @default(false)
  order Int     @default(0)

  createdAt DateTime @default(now())

  @@index([sessionPlanId])
  @@map("checklist_items")
}

model Scene {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String
  sessionPlan   SessionPlan @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)

  title     String
  summary   String?
  readAloud String?
  goal      String?
  order     Int         @default(0)
  status    SceneStatus @default(PLANNED)

  favorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([sessionPlanId, order])
  @@map("scenes")
}

model Quest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  objective   String?
  reward      String?
  status      QuestStatus @default(NOT_STARTED)
  visibility  Visibility  @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags QuestTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("quests")
}

model PlotThread {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      PlotThreadStatus       @default(ACTIVE)
  importance  RelationshipImportance @default(MEDIUM)
  visibility  Visibility             @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags PlotThreadTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("plot_threads")
}

model Consequence {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  trigger     String?
  description String?
  status      ConsequenceStatus @default(PENDING)
  visibility  Visibility        @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags ConsequenceTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("consequences")
}

model QuestTag {
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questId, tagId])
  @@index([tagId])
  @@map("quest_tags")
}

model PlotThreadTag {
  plotThreadId String
  plotThread   PlotThread @relation(fields: [plotThreadId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([plotThreadId, tagId])
  @@index([tagId])
  @@map("plot_thread_tags")
}

model ConsequenceTag {
  consequenceId String
  consequence   Consequence @relation(fields: [consequenceId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([consequenceId, tagId])
  @@index([tagId])
  @@map("consequence_tags")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 3 — Modo Sessão
// ─────────────────────────────────────────────────────────────────────────

enum SessionLogEntryType {
  NOTE
  DICE_ROLL
  COMBAT_EVENT
}

/// Registro cronológico do que acontece durante uma sessão ao vivo. `clientId`
/// é gerado no navegador (não pelo banco) especificamente para suportar a
/// fila de escrita offline: ao reenviar uma entrada que já pode ter sido
/// criada antes de cair a conexão cair, o `@@unique` com `clientId` faz o
/// reenvio ser idempotente (ver ARCHITECTURE.md, "Modo Sessão offline").
model SessionLogEntry {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String?
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id], onDelete: SetNull)

  type     SessionLogEntryType @default(NOTE)
  content  String
  clientId String?

  createdAt DateTime @default(now())

  @@unique([campaignId, clientId])
  @@index([campaignId, createdAt])
  @@map("session_log_entries")
}

enum CombatantType {
  PC
  NPC
}

model CombatEncounter {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String?
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id], onDelete: SetNull)

  name              String
  round             Int       @default(1)
  activeCombatantId String?
  endedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  combatants Combatant[]

  @@index([campaignId, endedAt])
  @@map("combat_encounters")
}

model Combatant {
  id          String          @id @default(cuid())
  encounterId String
  encounter   CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  name       String
  type       CombatantType @default(NPC)
  initiative Int           @default(0)
  hpCurrent  Int?
  hpMax      Int?
  conditions String?
  order      Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([encounterId, order])
  @@map("combatants")
}
