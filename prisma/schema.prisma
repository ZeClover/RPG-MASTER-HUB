// RPG Master Hub
// Fase 0: usuários, autenticação (Auth.js) e campanhas.
// Fase 1: wiki da campanha — NPCs, Locais, Facções, Lore, Ideias, Tags e
// o sistema genérico de Relacionamentos (ver ARCHITECTURE.md, seção "Relacionamentos").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  OWNER
  CO_GM
  PLAYER
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  campaigns   Campaign[]       @relation("CampaignOwner")
  memberships CampaignMember[]
  characters  Character[]      @relation("CharacterPlayer")

  @@map("users")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  bannerUrl      String?
  iconUrl        String?
  symbolUrl      String?
  backgroundUrl  String?
  primaryColor   String?
  secondaryColor String?
  status         CampaignStatus @default(ACTIVE)
  archivedAt     DateTime?
  lastSessionAt  DateTime?
  nextSessionAt  DateTime?

  ownerId String
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members CampaignMember[]

  npcs          Npc[]
  locations     Location[]
  factions      Faction[]
  lorePages     LorePage[]
  ideas         Idea[]
  tags          Tag[]
  relationships Relationship[]

  sessionPlans       SessionPlan[]
  scenes             Scene[]
  quests             Quest[]
  plotThreads        PlotThread[]
  consequences       Consequence[]
  sessionLogEntries  SessionLogEntry[]
  combatEncounters   CombatEncounter[]
  audioTracks        AudioTrack[]
  sfxTriggerEvents   SfxTriggerEvent[]
  discordLink        DiscordLink?
  musicPlaybackState MusicPlaybackState?

  timelineEvents  TimelineEvent[]
  calendar        CampaignCalendar?
  narrativeClocks NarrativeClock[]
  familyRelations FamilyRelation[]
  mysteries       Mystery[]

  monsters   Monster[]
  items      Item[]
  powers     Power[]
  rollTables RollTable[]

  handouts Handout[]

  moduleSettings   CampaignModuleSetting[]
  characters       Character[]
  customCategories CustomCategory[]

  attributeDefs   AttributeDef[]
  resourceDefs    ResourceDef[]
  skillDefs       SkillDef[]
  conditionDefs   ConditionDef[]
  rollFormulaDefs RollFormulaDef[]
  sheetSections   SheetSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 1 — Wiki da campanha
// ─────────────────────────────────────────────────────────────────────────

/// Ciclo de vida narrativo do conteúdo (independente do `archived` de cada
/// entidade, que é só um "esconder da minha lista de trabalho" organizacional).
enum CanonStatus {
  DRAFT
  PROPOSED
  APPROVED
  CANON
  OBSOLETE
  ARCHIVED
}

enum Visibility {
  GM_ONLY
  PLAYERS
  PUBLIC
}

enum IdeaState {
  NEW
  INTERESTING
  DEVELOPING
  USED
  ARCHIVED
  DISCARDED
}

/// Tipos de entidade que podem participar de um Relationship. Estender este
/// enum é o custo esperado para plugar um novo tipo de conteúdo no sistema de
/// relacionamentos (ver ARCHITECTURE.md). TIMELINE_EVENT e MYSTERY chegaram
/// na Fase 5 (seção 16.1); MONSTER, ITEM e POWER chegaram na Fase 6 (seção 17.1).
enum RelatableEntityType {
  NPC
  LOCATION
  FACTION
  LORE_PAGE
  QUEST
  PLOT_THREAD
  CONSEQUENCE
  TIMELINE_EVENT
  MYSTERY
  MONSTER
  ITEM
  POWER
}

enum RelationshipImportance {
  LOW
  MEDIUM
  HIGH
}

model Npc {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name            String
  imageUrl        String?
  age             String?
  species         String?
  gender          String?
  appearance      String?
  personality     String?
  history         String?
  goals           String?
  fears           String?
  secrets         String?
  narrativeStatus String?
  gmNotes         String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags NpcTag[]

  familyRelationsAsA FamilyRelation[] @relation("FamilyRelationNpcA")
  familyRelationsAsB FamilyRelation[] @relation("FamilyRelationNpcB")

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("npcs")
}

model Location {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name         String
  imageUrl     String?
  description  String?
  locationType String?
  notes        String?

  parentLocationId String?
  parent           Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children         Location[] @relation("LocationHierarchy")

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags LocationTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@index([parentLocationId])
  @@map("locations")
}

model Faction {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  imageUrl    String?
  factionType String?
  description String?
  history     String?
  goals       String?
  resources   String?
  secrets     String?
  notes       String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags FactionTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("factions")
}

model LorePage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title    String
  content  String?
  imageUrl String?
  category String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags LorePageTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("lore_pages")
}

model Idea {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title   String
  content String?
  state   IdeaState @default(NEW)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags IdeaTag[]

  @@index([campaignId, archived])
  @@index([campaignId, state])
  @@map("ideas")
}

model Tag {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name  String
  slug  String
  color String?

  createdAt DateTime @default(now())

  npcs           NpcTag[]
  locations      LocationTag[]
  factions       FactionTag[]
  lorePages      LorePageTag[]
  ideas          IdeaTag[]
  quests         QuestTag[]
  plotThreads    PlotThreadTag[]
  consequences   ConsequenceTag[]
  timelineEvents TimelineEventTag[]
  mysteries      MysteryTag[]
  monsters       MonsterTag[]
  items          ItemTag[]
  powers         PowerTag[]

  @@unique([campaignId, slug])
  @@map("tags")
}

model NpcTag {
  npcId String
  npc   Npc    @relation(fields: [npcId], references: [id], onDelete: Cascade)
  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([npcId, tagId])
  @@index([tagId])
  @@map("npc_tags")
}

model LocationTag {
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([locationId, tagId])
  @@index([tagId])
  @@map("location_tags")
}

model FactionTag {
  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([factionId, tagId])
  @@index([tagId])
  @@map("faction_tags")
}

model LorePageTag {
  lorePageId String
  lorePage   LorePage @relation(fields: [lorePageId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lorePageId, tagId])
  @@index([tagId])
  @@map("lore_page_tags")
}

model IdeaTag {
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@index([tagId])
  @@map("idea_tags")
}

/// Relacionamento polimórfico genérico entre entidades da wiki. Ver
/// ARCHITECTURE.md ("Relacionamentos") para a discussão das alternativas e
/// por que este desenho foi escolhido.
model Relationship {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sourceType RelatableEntityType
  sourceId   String
  targetType RelatableEntityType
  targetId   String

  type        String
  description String?
  importance  RelationshipImportance?
  visibility  Visibility              @default(GM_ONLY)

  createdAt DateTime @default(now())

  @@index([campaignId, sourceType, sourceId])
  @@index([campaignId, targetType, targetId])
  @@map("relationships")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 2 — Preparação
// ─────────────────────────────────────────────────────────────────────────

enum SessionPlanStatus {
  PLANNING
  READY
  DONE
  CANCELLED
}

enum SceneStatus {
  PLANNED
  PLAYED
  CUT
}

enum QuestStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum PlotThreadStatus {
  ACTIVE
  DORMANT
  RESOLVED
  ABANDONED
}

enum ConsequenceStatus {
  PENDING
  TRIGGERED
  RESOLVED
}

model SessionPlan {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title         String
  sessionNumber Int?
  plannedDate   DateTime?
  pitch         String?
  gmNotes       String?
  status        SessionPlanStatus @default(PLANNING)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes           Scene[]
  checklist        ChecklistItem[]
  logEntries       SessionLogEntry[]
  combatEncounters CombatEncounter[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("session_plans")
}

model ChecklistItem {
  id            String      @id @default(cuid())
  sessionPlanId String
  sessionPlan   SessionPlan @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)

  label String
  done  Boolean @default(false)
  order Int     @default(0)

  createdAt DateTime @default(now())

  @@index([sessionPlanId])
  @@map("checklist_items")
}

model Scene {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String
  sessionPlan   SessionPlan @relation(fields: [sessionPlanId], references: [id], onDelete: Cascade)

  title     String
  summary   String?
  readAloud String?
  goal      String?
  order     Int         @default(0)
  status    SceneStatus @default(PLANNED)

  favorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([sessionPlanId, order])
  @@map("scenes")
}

model Quest {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  objective   String?
  reward      String?
  status      QuestStatus @default(NOT_STARTED)
  visibility  Visibility  @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags QuestTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("quests")
}

model PlotThread {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      PlotThreadStatus       @default(ACTIVE)
  importance  RelationshipImportance @default(MEDIUM)
  visibility  Visibility             @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags PlotThreadTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("plot_threads")
}

model Consequence {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  trigger     String?
  description String?
  status      ConsequenceStatus @default(PENDING)
  visibility  Visibility        @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags ConsequenceTag[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("consequences")
}

model QuestTag {
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questId, tagId])
  @@index([tagId])
  @@map("quest_tags")
}

model PlotThreadTag {
  plotThreadId String
  plotThread   PlotThread @relation(fields: [plotThreadId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([plotThreadId, tagId])
  @@index([tagId])
  @@map("plot_thread_tags")
}

model ConsequenceTag {
  consequenceId String
  consequence   Consequence @relation(fields: [consequenceId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([consequenceId, tagId])
  @@index([tagId])
  @@map("consequence_tags")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 3 — Modo Sessão
// ─────────────────────────────────────────────────────────────────────────

enum SessionLogEntryType {
  NOTE
  DICE_ROLL
  COMBAT_EVENT
}

/// Registro cronológico do que acontece durante uma sessão ao vivo. `clientId`
/// é gerado no navegador (não pelo banco) especificamente para suportar a
/// fila de escrita offline: ao reenviar uma entrada que já pode ter sido
/// criada antes de cair a conexão cair, o `@@unique` com `clientId` faz o
/// reenvio ser idempotente (ver ARCHITECTURE.md, "Modo Sessão offline").
model SessionLogEntry {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String?
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id], onDelete: SetNull)

  type     SessionLogEntryType @default(NOTE)
  content  String
  clientId String?

  createdAt DateTime @default(now())

  @@unique([campaignId, clientId])
  @@index([campaignId, createdAt])
  @@map("session_log_entries")
}

enum CombatantType {
  PC
  NPC
}

model CombatEncounter {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionPlanId String?
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id], onDelete: SetNull)

  name              String
  round             Int       @default(1)
  activeCombatantId String?
  endedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  combatants Combatant[]

  @@index([campaignId, endedAt])
  @@map("combat_encounters")
}

model Combatant {
  id          String          @id @default(cuid())
  encounterId String
  encounter   CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  name       String
  type       CombatantType @default(NPC)
  initiative Int           @default(0)
  hpCurrent  Int?
  hpMax      Int?
  conditions String?
  order      Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([encounterId, order])
  @@map("combatants")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 4 — Áudio (Music/SFX Board + bots do Discord)
// ─────────────────────────────────────────────────────────────────────────

enum AudioTrackCategory {
  MUSIC
  SFX
}

/// Um item do Music/SFX Board: cada faixa enviada já É o "preset" — um botão
/// no board que o mestre aciona. Não existe um agrupamento "Preset" separado
/// (ver ARCHITECTURE.md, seção 15).
model AudioTrack {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name     String
  category AudioTrackCategory
  fileUrl  String
  loop     Boolean            @default(true)

  createdAt DateTime @default(now())

  sfxTriggerEvents    SfxTriggerEvent[]
  musicPlaybackStates MusicPlaybackState[]

  @@index([campaignId, category])
  @@map("audio_tracks")
}

/// Onde os dois bots devem entrar para esta campanha. Configurado manualmente
/// pelo mestre (ids numéricos copiados do Discord) — sem OAuth "Entrar com
/// Discord" para listar servidores automaticamente, fora de escopo desta fase.
model DiscordLink {
  id             String   @id @default(cuid())
  campaignId     String   @unique
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guildId        String
  voiceChannelId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discord_links")
}

/// Estado contínuo do bot de trilha sonora — um registro por campanha,
/// atualizado pelo mestre e lido (via polling) pelo processo do bot.
model MusicPlaybackState {
  id         String      @id @default(cuid())
  campaignId String      @unique
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackId    String?
  track      AudioTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  isPlaying  Boolean     @default(false)

  updatedAt DateTime @updatedAt

  @@map("music_playback_states")
}

/// Fila de disparos do bot de efeitos sonoros — cada linha é um "toque uma
/// vez"; o bot marca `processedAt` depois de tocar (evita tocar de novo se
/// consultar a fila outra vez antes do próximo poll).
model SfxTriggerEvent {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trackId    String
  track      AudioTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([campaignId, processedAt])
  @@map("sfx_trigger_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 5 — World Building (Timeline, Calendário, Relógios Narrativos,
// Family Tree, Mystery Board)
// ─────────────────────────────────────────────────────────────────────────

/// Evento histórico/narrativo da campanha. `narrativeDate` é texto livre (o
/// calendário do mundo de ficção é definido pelo mestre, não pelo app — ver
/// ARCHITECTURE.md, seção 16.2); `order` é quem de fato ordena a lista,
/// reordenável mesmo sem datas exatas, mesmo padrão de `Scene.order` (13.2).
model TimelineEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  narrativeDate String?
  order         Int     @default(0)

  visibility Visibility @default(GM_ONLY)
  favorite   Boolean    @default(false)
  archived   Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags TimelineEventTag[]

  @@index([campaignId, archived])
  @@index([campaignId, order])
  @@map("timeline_events")
}

model TimelineEventTag {
  timelineEventId String
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  tagId           String
  tag             Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timelineEventId, tagId])
  @@index([tagId])
  @@map("timeline_event_tags")
}

/// Corte de escopo deliberado (ver ARCHITECTURE.md, seção 16.2): em vez de um
/// sistema de calendário customizável (meses/dias com nomes próprios do
/// mundo de ficção), a Fase 5 entrega só um contador "dia atual da campanha"
/// — uma linha por campanha, no mesmo padrão singleton de `DiscordLink`/
/// `MusicPlaybackState` (Fase 4). Sem tabela própria de página: é um widget
/// no topo da Timeline.
model CampaignCalendar {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  currentDay Int    @default(1)
  dayLabel   String @default("Dia")

  updatedAt DateTime @updatedAt

  @@map("campaign_calendars")
}

/// Relógio narrativo (padrão PbtA/Blades in the Dark): progresso de uma
/// ameaça ou objetivo em `segments` fatias, `filled` preenchidas. Sem
/// `visibility`/tags/Relacionamentos — é uma ferramenta de acompanhamento do
/// mestre, não conteúdo compartilhável da wiki (mesmo raciocínio de
/// `SessionPlan` não ter `canonStatus`/`visibility`, seção 13.5).
model NarrativeClock {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  segments    Int     @default(4)
  filled      Int     @default(0)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, archived])
  @@map("narrative_clocks")
}

/// Tipo de parentesco entre dois NPCs. `PARENT_OF`/`SIBLING_OF` cobrem a
/// direção inversa por leitura (o pai de A é A lido do lado B) — ver
/// ARCHITECTURE.md, seção 16.3, para a decisão de não usar `RelatableEntityType`.
enum FamilyRelationType {
  PARENT_OF
  SPOUSE_OF
  SIBLING_OF
}

/// Parentesco entre dois NPCs — tabela dedicada com FK real (não polimórfica),
/// porque os dois lados são sempre NPC (ver ARCHITECTURE.md, seção 16.3, para
/// o trade-off frente ao sistema genérico de Relacionamentos, seção 12.1).
model FamilyRelation {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  npcAId String
  npcA   Npc    @relation("FamilyRelationNpcA", fields: [npcAId], references: [id], onDelete: Cascade)
  npcBId String
  npcB   Npc    @relation("FamilyRelationNpcB", fields: [npcBId], references: [id], onDelete: Cascade)

  relationType FamilyRelationType
  notes        String?

  createdAt DateTime @default(now())

  @@unique([npcAId, npcBId, relationType])
  @@index([campaignId])
  @@index([npcBId])
  @@map("family_relations")
}

enum MysteryStatus {
  OPEN
  RESOLVED
}

/// Mistério/investigação: entra no sistema de Relacionamentos genérico (ex.:
/// um NPC pode ser "suspeito em" um Mistério) porque, ao contrário de Clue
/// (abaixo), tem página de detalhe própria — mesmo critério da seção 13.1.
model Mystery {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      MysteryStatus @default(OPEN)
  visibility  Visibility    @default(GM_ONLY)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags  MysteryTag[]
  clues Clue[]

  @@index([campaignId, archived])
  @@index([campaignId, status])
  @@map("mysteries")
}

model MysteryTag {
  mysteryId String
  mystery   Mystery @relation(fields: [mysteryId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mysteryId, tagId])
  @@index([tagId])
  @@map("mystery_tags")
}

/// Pista de um Mistério: filho direto (FK real, mesmo padrão de Scene/
/// ChecklistItem — seção 13.2), sem página própria (sempre editada inline na
/// página do Mistério). `linkedEntityType`/`linkedEntityId` é um ponteiro
/// polimórfico leve e opcional (resolvido por `resolveEntityRefs`, o mesmo
/// resolvedor do sistema de Relacionamentos) — não uma linha em `Relationship`,
/// porque uma pista não tem lado próprio para uma relação bidirecional
/// aparecer (ver ARCHITECTURE.md, seção 16.4).
model Clue {
  id        String  @id @default(cuid())
  mysteryId String
  mystery   Mystery @relation(fields: [mysteryId], references: [id], onDelete: Cascade)

  text       String
  discovered Boolean @default(false)
  /// Player Knowledge (Fase 9, ver ARCHITECTURE.md, seção 21.3): distinto de
  /// `discovered` (controle interno do mestre) — só pistas com
  /// `sharedWithPlayers: true` aparecem para um PLAYER.
  sharedWithPlayers Boolean @default(false)
  order      Int     @default(0)

  linkedEntityType RelatableEntityType?
  linkedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mysteryId, order])
  @@map("clues")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 6 — Game Tools (Monster/Boss/Item Forge, Power Builder,
// Loot Generator, Table Builder)
// ─────────────────────────────────────────────────────────────────────────

/// Monstro ou Chefe da campanha (Monster/Boss Forge). `isBoss` distingue um
/// chefe de um monstro comum no mesmo modelo, em vez de duas tabelas — ver
/// ARCHITECTURE.md, seção 17.1. Participa de Tags/Relacionamentos/Busca como
/// as demais entidades de conteúdo (mesmo critério de `Faction`/`Npc`).
model Monster {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  imageUrl    String?
  isBoss      Boolean @default(false)
  description String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes MonsterAttribute[]
  tags       MonsterTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("monsters")
}

/// Estatística livre de um monstro (ex.: "HP" → "40", "Ataque" → "+5") — uma
/// lista de chave/valor, filho direto (FK real, mesmo padrão de Clue/Scene),
/// porque não existe um conjunto fixo de atributos que sirva a todo sistema
/// de jogo (ver ARCHITECTURE.md, seções 14.3 e 17.1).
model MonsterAttribute {
  id        String  @id @default(cuid())
  monsterId String
  monster   Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  key   String
  value String
  order Int    @default(0)

  @@index([monsterId, order])
  @@map("monster_attributes")
}

model MonsterTag {
  monsterId String
  monster   Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([monsterId, tagId])
  @@index([tagId])
  @@map("monster_tags")
}

/// Item da campanha (Item Forge). `category` cobre "tipo/raridade" como um
/// único campo de texto livre (ex. "Arma rara", "Anel +1") — ver
/// ARCHITECTURE.md, seção 17.1, para o porquê de não ter dois campos fixos.
model Item {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  imageUrl    String?
  category    String?
  description String?
  effect      String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags ItemTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("items")
}

model ItemTag {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

/// Poder/habilidade/magia (Power Builder). `cost` é texto livre (ex. "2 PM",
/// "Ação bônus") pelo mesmo motivo de `MonsterAttribute`: cada sistema de
/// jogo tem seu próprio recurso de custo — ver ARCHITECTURE.md, seção 17.2.
model Power {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  cost        String?
  description String?
  effect      String?

  canonStatus CanonStatus @default(DRAFT)
  visibility  Visibility  @default(GM_ONLY)
  favorite    Boolean     @default(false)
  archived    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags PowerTag[]

  @@index([campaignId, archived])
  @@index([campaignId, favorite])
  @@map("powers")
}

model PowerTag {
  powerId String
  power   Power  @relation(fields: [powerId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([powerId, tagId])
  @@index([tagId])
  @@map("power_tags")
}

enum RollTableKind {
  GENERIC
  LOOT
}

/// Tabela de rolagem genérica (Table Builder). O Loot Generator é a MESMA
/// tabela com `kind = LOOT`, não um modelo separado — ver ARCHITECTURE.md,
/// seção 17.3, para a decisão de reaproveitar em vez de duplicar. Sem
/// `visibility`/tags/Relacionamentos: é uma ferramenta de mesa do mestre, não
/// conteúdo compartilhável da wiki (mesmo raciocínio de `NarrativeClock`, 16.2).
model RollTable {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  description String?
  kind        RollTableKind @default(GENERIC)

  favorite Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RollTableEntry[]

  @@index([campaignId, archived])
  @@index([campaignId, kind])
  @@map("roll_tables")
}

/// Entrada sorteável de uma RollTable. `weight` substitui uma faixa numérica
/// explícita (ex. "1-3") — o peso já representa o tamanho do intervalo sem
/// exigir do mestre calcular/validar limites contra o dado usado (ver
/// ARCHITECTURE.md, seção 17.3).
model RollTableEntry {
  id      String    @id @default(cuid())
  tableId String
  table   RollTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  label  String
  weight Int    @default(1)
  order  Int    @default(0)

  createdAt DateTime @default(now())

  @@index([tableId, order])
  @@map("roll_table_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 9 — Jogadores (Convite/Membros, Player View, Player Knowledge, Handouts)
// ─────────────────────────────────────────────────────────────────────────

/// Documento/imagem entregue aos jogadores durante a sessão (uma carta
/// encontrada, um mapa, uma pista física) — ver ARCHITECTURE.md, seção 21.4.
/// `revealed` (não `visibility`/`GM_ONLY`-`PLAYERS`) é o eixo de acesso aqui
/// de propósito: um Handout não tem meio-termo "PUBLIC" nem faz sentido pré-
/// classificar como "para jogadores" antes de existir — ele é sempre GM-only
/// até o mestre clicar em revelar, um binário mais simples que o enum
/// `Visibility` de três estados usado pelo resto da wiki.
model Handout {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title    String
  content  String?
  imageUrl String?

  revealed   Boolean   @default(false)
  revealedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, revealed])
  @@map("handouts")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 10 — Módulos de campanha, Personagens e Categorias Personalizadas
// ─────────────────────────────────────────────────────────────────────────

/// Override por campanha do estado ligado/desligado de um módulo (ver
/// ARCHITECTURE.md, seção 21). `moduleKey` é a `key` do item correspondente
/// em `CAMPAIGN_NAV_ITEMS` — sem enum, porque a lista de módulos alternáveis
/// vive no código (registro em `campaign-nav-items.ts`), não no banco. Uma
/// linha só existe aqui quando o mestre já mexeu no padrão; a ausência de
/// linha para uma chave significa "use o `defaultEnabled` do registro".
model CampaignModuleSetting {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  moduleKey  String
  enabled    Boolean

  updatedAt DateTime @updatedAt

  @@unique([campaignId, moduleKey])
  @@map("campaign_module_settings")
}

/// Ficha simples de personagem jogador (Fase 10, ver ARCHITECTURE.md, seção
/// 21.2) — o hub nunca teve um conceito de PC, só NPC. `gmNotes` segue o
/// mesmo padrão de `Npc.gmNotes`/`Faction.secrets`: campo livre, zerado para
/// PLAYER via `stripGmFields` (reaproveitado sem exigir que Character entre
/// no sistema de `RelatableEntityType`/Relationship).
model Character {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  playerId   String
  player     User     @relation("CharacterPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  name     String
  concept  String?
  imageUrl String?
  bio      String? @db.Text
  gmNotes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@map("characters")
}

/// Categoria nomeada pelo mestre (Fase 10, ver ARCHITECTURE.md, seção 21.3)
/// — o "arsenal maior" pedido: em vez de features fixas ("Matéria Escolar",
/// "Artes Importantes"), um par Categoria→Entrada genérico, mesmo desenho de
/// RollTable→RollTableEntry (Fase 6, seção 17.3).
model CustomCategory {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  description String?

  entries CustomCategoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@map("custom_categories")
}

/// Entrada de uma CustomCategory. Tem `visibility` (o enum de três estados,
/// não o binário de `Handout.revealed`) porque, ao contrário de um Handout,
/// uma entrada de categoria é conteúdo de wiki desde a criação — pode nascer
/// já como PLAYERS/PUBLIC, sem precisar de um "revelar" explícito.
model CustomCategoryEntry {
  id         String         @id @default(cuid())
  categoryId String
  category   CustomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  title      String
  content    String?    @db.Text
  imageUrl   String?
  visibility Visibility @default(GM_ONLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("custom_category_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 13 — Construtor de Sistema
// ─────────────────────────────────────────────────────────────────────────

/// As 6 áreas de uma ficha (`SheetSection`, abaixo). `CUSTOM_TEXT` é a única
/// seção com conteúdo próprio (`customText`) — as demais só referenciam "a
/// lista atual de X da campanha" (Atributos/Recursos/Perícias/Condições/
/// Fórmulas), sem duplicar dado.
enum SheetSectionKind {
  ATTRIBUTES
  RESOURCES
  SKILLS
  CONDITIONS
  FORMULAS
  CUSTOM_TEXT
}

/// Atributo do sistema de jogo da campanha (ex.: Força, Destreza). `key` é o
/// token que `RollFormulaDef.formula` referencia como `{key}` — gerado a
/// partir de `name` com `slugifyTagName` (mesmo utilitário/padrão de
/// colisão de `Tag`, ver ARCHITECTURE.md). `gmOnly` marca um atributo como
/// campo secreto da ficha — some da leitura de um PLAYER (ver
/// `stripSystemGmOnly` em `queries.ts`).
model AttributeDef {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name         String
  key          String
  description  String?
  defaultValue Int      @default(0)
  gmOnly       Boolean  @default(false)
  order        Int      @default(0)

  skills SkillDef[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, key])
  @@index([campaignId, order])
  @@map("attribute_defs")
}

/// Recurso consumível/rastreável do sistema (ex.: PV, PM). Só define o
/// "molde" (nome, `key`, máximo padrão) — o valor atual/máximo por
/// personagem é responsabilidade da Fase 14 (ver ARCHITECTURE.md).
model ResourceDef {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  key         String
  description String?
  defaultMax  Int      @default(0)
  gmOnly      Boolean  @default(false)
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, key])
  @@index([campaignId, order])
  @@map("resource_defs")
}

/// Perícia do sistema, opcionalmente ligada a um atributo (ex.: Atletismo →
/// Força) só para exibição/organização — a fórmula de rolagem de uma
/// perícia é um `RollFormulaDef` à parte, não um campo aqui. Excluir o
/// atributo relacionado limpa o vínculo (`SetNull`), a perícia continua
/// existindo "sem atributo relacionado".
model SkillDef {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name               String
  key                String
  relatedAttributeId String?
  relatedAttribute   AttributeDef? @relation(fields: [relatedAttributeId], references: [id], onDelete: SetNull)
  defaultBonus       Int           @default(0)
  gmOnly             Boolean       @default(false)
  order              Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, key])
  @@index([campaignId, order])
  @@map("skill_defs")
}

/// Condição/status que pode ser aplicado a um personagem (ex.: Envenenado,
/// Atordoado) — só o catálogo da campanha; aplicar uma condição a um PC
/// específico é Fase 14. Sem `key`/token: condições não entram em fórmulas.
model ConditionDef {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String?
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, order])
  @@map("condition_defs")
}

/// Fórmula de rolagem nomeada (ex.: "Teste de Força" → "1d20 + {forca}").
/// Validada em `createRollFormulaAction`/`updateRollFormulaAction` contra as
/// `key`s de `AttributeDef`/`SkillDef` existentes na campanha (ver
/// `src/lib/formula.ts`) — nunca contra dados de personagem, que ainda não
/// existem nesta fase.
model RollFormulaDef {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name        String
  formula     String
  description String?
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, order])
  @@map("roll_formula_defs")
}

/// Uma seção do layout da ficha única da campanha (ver ARCHITECTURE.md —
/// deliberadamente UM template implícito por campanha, não vários; "aluno
/// vs. professor vs. monstro" fica para fase futura). `customText` só é
/// relevante quando `kind = CUSTOM_TEXT`; para as demais `kind`s, a seção é
/// só um marcador de "aqui entra a lista de X", sem conteúdo próprio.
model SheetSection {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind       SheetSectionKind
  title      String
  customText String?
  gmOnly     Boolean          @default(false)
  order      Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, order])
  @@map("sheet_sections")
}
