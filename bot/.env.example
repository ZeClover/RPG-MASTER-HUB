# URL onde o hub (app Next.js) está rodando e acessível pelos bots.
# Em desenvolvimento local, os bots e o hub rodam na mesma máquina:
HUB_BASE_URL="http://localhost:3000"

# Mesmo valor configurado em BOT_SERVICE_SECRET no .env do hub (raiz do
# projeto). Os bots autenticam nas rotas /api/v1/bot/* com este secret via
# header "Authorization: Bearer <secret>" — nunca com login de usuário.
BOT_SERVICE_SECRET="replace-me-with-a-real-secret"

# Token e Application ID do bot de trilha sonora (Discord Developer Portal
# → sua aplicação → Bot → Reset Token). Nunca comitar o valor real.
DISCORD_MUSIC_BOT_TOKEN="replace-me"
DISCORD_MUSIC_BOT_CLIENT_ID="replace-me"

# Token e Application ID do bot de efeitos sonoros (aplicação separada da
# de trilha sonora — ver ARCHITECTURE.md, "Bots do Discord").
DISCORD_SFX_BOT_TOKEN="replace-me"
DISCORD_SFX_BOT_CLIENT_ID="replace-me"
